{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "asmrone",
  "version": "0.1.0",
  "identifier": "com.gmail.karoyqiu.asmrone",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "asmr.one",
        "width": 700,
        "height": 1000,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'nonce-ss8Pp2gtzJFjs8y9GAtSS'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "externalBin": ["binaries/aria2c"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
